# Salin ke .env.local (lokal) atau isi di Vercel: Project -> Settings -> Environment Variables.
# Tanpa key ini pun aplikasi tetap bisa dibuka, tapi tombol Clone & Sintesis akan
# meminta API key (bisa juga diisi langsung di halaman Pengaturan aplikasi).

# API key Alibaba Cloud Model Studio (DashScope). Buat di:
# https://bailian.console.aliyun.com/ -> API-KEY -> Create API Key
DASHSCOPE_API_KEY=

# Opsional: Workspace ID Model Studio (region Beijing). Bila diisi, panggilan API
# memakai host https://<WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com/api/v1
# Bila kosong, memakai https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WORKSPACE_ID=

# Model target default untuk voice cloning (jalur cloud).
# Suara hasil clone terikat ke model ini dan tidak bisa dipakai di model lain.
DASHSCOPE_TARGET_MODEL=qwen-audio-3.1-tts-plus

# Opsional: URL backend lokal Qwen3-TTS (PC dengan GPU, lihat backend/README.md).
# Bila diisi, mode Lokal di aplikasi memakai URL ini.
QWEN_LOCAL_BACKEND_URL=http://127.0.0.1:8001
